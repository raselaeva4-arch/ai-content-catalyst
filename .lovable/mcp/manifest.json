            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Full text content of the KB entry."
            },
            "category": {
              "type": "string",
              "description": "Optional category label."
            }
          },
          "required": [
            "project_id",
            "title",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
